# Amazon Associates US tracking ID, added to every Amazon link at build time.
# Set the same variables in Vercel (Project Settings > Environment Variables) for Production and Preview.
AMAZON_ASSOCIATE_TAG=

# Optional: one tracking ID per page area, so the Associates reports show which page sells.
# Create them in Associates Central under Account Settings > Manage Tracking IDs.
# Any area left empty falls back to AMAZON_ASSOCIATE_TAG.
AMAZON_TAG_GYM=
AMAZON_TAG_PILATES=
AMAZON_TAG_RUNNING=
AMAZON_TAG_HOME_GYM=
AMAZON_TAG_PICKLEBALL=
AMAZON_TAG_GIFTS=
AMAZON_TAG_HOLIDAY=
