---
// Hand drawn gear illustrations in the site's sticker style. Every product image on
// the site comes from here, so nothing is hotlinked from retailers.
import type { GearKind } from '../data/art';

interface Props {
  kind: GearKind;
  /** Main body color. */
  fill?: string;
  /** Detail color (zips, labels, soles). */
  accent?: string;
  class?: string;
  title?: string;
}

const { kind, fill = '#f3f0e8', accent = '#fbfaf6', class: className = 'size-16', title } = Astro.props;
const F = fill;
const A = accent;
const INK = '#0d0f0c';
---
<svg
  viewBox="0 0 120 120"
  class:list={['gear-art shrink-0', className]}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  fill="none"
  stroke={INK}
  stroke-width="4"
  stroke-linejoin="round"
  stroke-linecap="round"
>
  {kind === 'duffel' && (
    <g>
      <path d="M40 46c0-22 40-22 40 0" stroke-width="6" />
      <rect x="12" y="44" width="96" height="56" rx="22" fill={F} />
      <path d="M24 58h72" stroke={INK} />
      <path d="M24 58h72" stroke={A} stroke-width="1.5" stroke-dasharray="3 3" />
      <rect x="38" y="68" width="44" height="20" rx="7" fill={A} />
      <path d="M50 78h20" />
      <circle cx="98" cy="58" r="3.5" fill={INK} stroke="none" />
    </g>
  )}

  {kind === 'bottle' && (
    <g>
      <path d="M52 22c0-14 16-14 16 0" stroke-width="5" />
      <rect x="46" y="20" width="28" height="14" rx="5" fill={A} />
      <rect x="38" y="32" width="44" height="76" rx="16" fill={F} />
      <rect x="38" y="58" width="44" height="22" fill={A} />
      <path d="M48 44v8" stroke={A} stroke-width="5" />
    </g>
  )}

  {kind === 'gloves' && (
    <g>
      <rect x="36" y="30" width="11" height="22" rx="5.5" fill={F} />
      <rect x="47" y="24" width="11" height="28" rx="5.5" fill={F} />
      <rect x="58" y="26" width="11" height="26" rx="5.5" fill={F} />
      <rect x="69" y="32" width="11" height="22" rx="5.5" fill={F} />
      <path d="M34 50h48v30c0 8-6 12-12 12H46c-6 0-12-4-12-12z" fill={F} />
      <path d="M34 64c-10-4-16-14-12-20 4-5 12 0 14 6" fill={F} />
      <path d="M36 32v8M47 26v8M58 28v8M69 34v8" stroke={A} stroke-width="3" />
      <rect x="32" y="86" width="52" height="20" rx="6" fill={A} />
      <path d="M44 96h28" />
    </g>
  )}

  {kind === 'shaker' && (
    <g>
      <rect x="64" y="12" width="16" height="14" rx="4" fill={A} />
      <rect x="30" y="24" width="60" height="16" rx="6" fill={A} />
      <path d="M36 40h48l-6 68H42z" fill={F} />
      <path d="M44 54h8M44 64h12M44 74h8" stroke={A} stroke-width="3.5" />
      <circle cx="62" cy="90" r="11" fill={A} />
      <path d="M53 86c6 4 12 4 18 0M53 94c6-4 12-4 18 0M62 79v22" stroke-width="2.5" />
    </g>
  )}

  {kind === 'towel' && (
    <g>
      <circle cx="26" cy="38" r="9" stroke-width="5" />
      <rect x="14" y="46" width="92" height="22" rx="8" fill={F} />
      <rect x="14" y="66" width="92" height="22" rx="8" fill={F} />
      <rect x="14" y="86" width="92" height="20" rx="8" fill={F} />
      <path d="M22 76h76M22 95h76" stroke={A} stroke-width="3.5" stroke-dasharray="1 7" />
    </g>
  )}

  {kind === 'mat' && (
    <g>
      <path d="M22 44h70v40H22c-6 0-10-9-10-20s4-20 10-20z" fill={F} />
      <circle cx="92" cy="64" r="20" fill={F} />
      <path d="M92 64m-4 0a4 4 0 1 1 8 0a8 8 0 1 1-16 0a12 12 0 1 1 24 0" stroke-width="3" />
      <rect x="44" y="40" width="10" height="48" rx="3" fill={A} />
      <path d="M12 98c20-6 70-6 96 0" stroke={F} stroke-width="8" />
      <path d="M12 98c20-6 70-6 96 0" stroke-width="2" />
    </g>
  )}

  {kind === 'socks' && (
    <g>
      <path d="M44 14h28v46c0 10 6 16 16 20 12 5 10 26-6 24l-34-4c-12-2-14-14-8-24l4-8z" fill={F} />
      <rect x="42" y="12" width="32" height="14" rx="4" fill={A} />
      <circle cx="52" cy="92" r="2.6" fill={INK} stroke="none" />
      <circle cx="62" cy="94" r="2.6" fill={INK} stroke="none" />
      <circle cx="72" cy="96" r="2.6" fill={INK} stroke="none" />
      <circle cx="82" cy="96" r="2.6" fill={INK} stroke="none" />
      <path d="M78 74c6 2 10 6 10 12" stroke={A} stroke-width="3.5" />
    </g>
  )}

  {kind === 'bands' && (
    <g>
      <ellipse cx="44" cy="50" rx="30" ry="22" fill={F} />
      <ellipse cx="44" cy="50" rx="20" ry="13" fill="#fbfaf6" />
      <ellipse cx="76" cy="62" rx="30" ry="22" fill={A} />
      <ellipse cx="76" cy="62" rx="20" ry="13" fill="#fbfaf6" />
      <ellipse cx="56" cy="80" rx="30" ry="22" fill={F} />
      <ellipse cx="56" cy="80" rx="20" ry="13" fill="#fbfaf6" />
    </g>
  )}

  {kind === 'shoe' && (
    <g>
      <path d="M12 80c0-12 10-18 22-20l22-24c5-5 14-4 17 2l10 18c13 2 25 8 27 22v6H12z" fill={F} />
      <rect x="10" y="82" width="100" height="16" rx="8" fill={A} />
      <path d="M58 44l8 6M53 50l8 6M48 56l8 6" />
      <path d="M30 70c18 2 40-4 56 2" stroke={A} stroke-width="4" />
    </g>
  )}

  {kind === 'court-shoe' && (
    <g>
      <path d="M10 84c0-12 8-18 20-20l20-20c6-6 14-6 18 0l12 16c16 2 28 10 30 22v4H10z" fill={F} />
      <rect x="8" y="84" width="104" height="14" rx="5" fill={A} />
      <path d="M56 50l8 6M50 56l8 6M44 62l8 6" />
      <path d="M86 70c8 2 14 6 16 12" stroke-width="3" />
      <path d="M18 91h84" stroke-width="2" stroke-dasharray="4 4" />
    </g>
  )}

  {kind === 'belt' && (
    <g>
      <path d="M6 58c30 8 78 8 108 0v22c-30 8-78 8-108 0z" fill={F} />
      <rect x="38" y="54" width="44" height="32" rx="10" fill={A} />
      <path d="M46 64h28" />
      <path d="M46 64h28" stroke={F} stroke-width="1.5" stroke-dasharray="2 3" />
      <rect x="86" y="40" width="14" height="30" rx="6" fill={A} />
      <rect x="88" y="34" width="10" height="8" rx="2" fill={F} />
    </g>
  )}

  {kind === 'shirt' && (
    <g>
      <path d="M42 18 24 26 10 48l16 10 6-8v56h56V50l6 8 16-10-14-22-18-8c-4 8-12 12-18 12s-14-4-18-12z" fill={F} />
      <path d="M42 18c4 8 12 12 18 12s14-4 18-12" stroke={A} stroke-width="6" />
      <path d="M42 18c4 8 12 12 18 12s14-4 18-12" />
      <path d="M44 74l6 6 6-6 6 6 6-6 6 6" stroke={A} stroke-width="3.5" />
    </g>
  )}

  {kind === 'dumbbell' && (
    <g>
      <rect x="40" y="55" width="40" height="10" rx="4" fill={A} />
      <rect x="10" y="36" width="12" height="48" rx="4" fill={F} />
      <rect x="20" y="30" width="12" height="60" rx="4" fill={F} />
      <rect x="30" y="38" width="10" height="44" rx="4" fill={F} />
      <rect x="80" y="38" width="10" height="44" rx="4" fill={F} />
      <rect x="88" y="30" width="12" height="60" rx="4" fill={F} />
      <rect x="98" y="36" width="12" height="48" rx="4" fill={F} />
      <circle cx="60" cy="98" r="10" fill={A} />
      <path d="M60 92v6" />
    </g>
  )}

  {kind === 'pullup' && (
    <g>
      <path d="M14 16v94M106 16v94" stroke-width="6" />
      <rect x="18" y="24" width="12" height="30" rx="3" fill={A} />
      <rect x="90" y="24" width="12" height="30" rx="3" fill={A} />
      <rect x="10" y="40" width="100" height="10" rx="5" fill={A} />
      <rect x="16" y="36" width="26" height="18" rx="9" fill={F} />
      <rect x="78" y="36" width="26" height="18" rx="9" fill={F} />
      <rect x="48" y="36" width="24" height="18" rx="9" fill={F} />
    </g>
  )}

  {kind === 'roller' && (
    <g>
      <rect x="12" y="38" width="84" height="48" rx="10" fill={F} />
      <ellipse cx="96" cy="62" rx="14" ry="24" fill={A} />
      <ellipse cx="96" cy="62" rx="6" ry="11" fill={F} />
      <path d="M24 46v8M36 46v8M48 46v8M60 46v8M72 46v8M30 62v8M42 62v8M54 62v8M66 62v8M78 62v8" stroke={A} stroke-width="4" />
    </g>
  )}

  {kind === 'paddle' && (
    <g>
      <rect x="30" y="8" width="60" height="70" rx="26" fill={F} />
      <rect x="36" y="14" width="48" height="58" rx="21" stroke={A} stroke-width="3" />
      <rect x="51" y="74" width="18" height="38" rx="6" fill={A} />
      <path d="M51 84l18 6M51 94l18 6M51 104l18 6" stroke-width="2.5" />
    </g>
  )}

  {kind === 'balls' && (
    <g>
      <circle cx="46" cy="66" r="30" fill={F} />
      {[[34, 52], [50, 46], [62, 60], [42, 70], [56, 80], [30, 80]].map(([x, y]) => <circle cx={x} cy={y} r="4.2" fill="#fbfaf6" stroke-width="2.5" />)}
      <circle cx="84" cy="80" r="24" fill={A} />
      {[[76, 70], [90, 72], [80, 86], [94, 88]].map(([x, y]) => <circle cx={x} cy={y} r="3.6" fill="#fbfaf6" stroke-width="2.5" />)}
    </g>
  )}

  {kind === 'backpack' && (
    <g>
      <rect x="52" y="8" width="16" height="22" rx="6" fill={A} />
      <path d="M48 28c0-10 24-10 24 0" stroke-width="5" />
      <rect x="26" y="26" width="68" height="84" rx="24" fill={F} />
      <rect x="36" y="70" width="48" height="30" rx="10" fill={A} />
      <path d="M44 80h32" />
      <path d="M30 50h60" stroke={A} stroke-width="3.5" />
    </g>
  )}

  {kind === 'glasses' && (
    <g>
      <path d="M8 48c10-8 30-8 44-4M112 48c-10-8-30-8-44-4" stroke-width="5" />
      <path d="M14 50h36c4 0 6 4 5 10-2 12-8 22-22 22S10 70 10 58c0-5 1-8 4-8z" fill={F} />
      <path d="M106 50H70c-4 0-6 4-5 10 2 12 8 22 22 22s23-12 23-24c0-5-1-8-4-8z" fill={F} />
      <path d="M55 54c2-4 8-4 10 0" stroke-width="5" />
      <path d="M20 60l10-6M76 60l10-6" stroke={A} stroke-width="4" />
    </g>
  )}
</svg>

<style>
  .gear-art {
    filter: drop-shadow(3px 3px 0 rgb(13 15 12 / 0.9));
    overflow: visible;
  }
</style>
