---
import type { Score } from '../data/types';
import { scoreTotal } from '../data/kits';

interface Props {
  score: Score;
  /** Bar color, defaults to ink. */
  color?: string;
  size?: 'sm' | 'lg';
}

const { score, color = 'currentColor', size = 'sm' } = Astro.props;
const total = scoreTotal(score);
const rows = [
  { label: 'Verified reviews', value: score.amazon, max: 50 },
  { label: 'Independent tests', value: score.tests, max: 35 },
  { label: 'Beginner proof', value: score.beginner, max: 15 },
];
const verdict = total >= 90 ? 'Exceptional' : total >= 80 ? 'Excellent' : total >= 70 ? 'Strong' : total >= 60 ? 'Solid' : 'Okay';
---
<div class:list={['reveal', size === 'lg' ? 'grid sm:grid-cols-[auto_1fr] gap-6 sm:gap-10 items-center' : 'grid grid-cols-[auto_1fr] gap-4 items-center']}>
  <div class="text-center" role="img" aria-label={`Score ${total} out of 100`}>
    <p class:list={['font-display font-extrabold leading-none tracking-tighter tabular-nums', size === 'lg' ? 'text-[5.5rem] sm:text-[7rem]' : 'text-[2.6rem]']}>
      {total}
    </p>
    <p class="tag opacity-60 mt-1">{verdict} · /100</p>
  </div>
  <dl class:list={['space-y-2', size === 'lg' ? 'text-sm' : 'text-[0.78rem]']}>
    {rows.map((r) => (
      <div>
        <div class="flex justify-between gap-3 mb-1">
          <dt class="opacity-75">{r.label}</dt>
          <dd class="font-mono font-bold tabular-nums">{r.value}<span class="opacity-50">/{r.max}</span></dd>
        </div>
        <div class:list={['bar rounded-full bg-current/12 overflow-hidden', size === 'lg' ? 'h-2.5' : 'h-1.5']} style={`color:${color}`}>
          <i style={`width:${(r.value / r.max) * 100}%`}></i>
        </div>
      </div>
    ))}
  </dl>
</div>
