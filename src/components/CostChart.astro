---
import { kits, kitPath, kitTotals } from '../data/kits';
import { formatPrice } from '../lib/links';

const rows = kits.map((kit) => ({ kit, ...kitTotals(kit) }));
const max = Math.max(...rows.map((r) => r.allIn));
// Round the axis up to a clean step so the gridlines land on round numbers.
const step = max > 1200 ? 500 : 250;
const axisMax = Math.ceil(max / step) * step;
const ticks = Array.from({ length: axisMax / step + 1 }, (_, i) => i * step);
const pct = (n: number) => `${(n / axisMax) * 100}%`;
---
<figure class="reveal">
  <div class="relative">
    <div class="hidden sm:block absolute inset-y-0 left-[10.5rem] right-0 pointer-events-none" aria-hidden="true">
      {ticks.map((t) => (
        <span class="absolute inset-y-0 border-l border-dashed border-paper/15" style={`left:${pct(t)}`}>
          <span class="absolute -bottom-7 -translate-x-1/2 font-mono text-[0.7rem] text-paper/40">{formatPrice(t)}</span>
        </span>
      ))}
    </div>

    <ul class="space-y-5 sm:space-y-4">
      {rows.map((r) => (
        <li class="sm:grid sm:grid-cols-[10.5rem_1fr] sm:items-center">
          <a href={kitPath(r.kit)} class="block font-display font-extrabold text-xl tracking-tight hover:underline underline-offset-4 mb-2 sm:mb-0" style={`color:${r.kit.color}`}>
            {r.kit.sport}
          </a>
          <div class="relative h-11">
            <div class="absolute inset-y-[18px] left-0 right-0 rounded-full bg-paper/8"></div>
            <div
              class="bar absolute inset-y-[14px] rounded-full overflow-hidden"
              style={`left:${pct(r.cheapest)}; width:calc(${pct(r.allIn - r.cheapest)}); color:${r.kit.color}`}
            >
              <i class="opacity-35"></i>
            </div>
            <span class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 size-3 rounded-full border-2 border-ink" style={`left:${pct(r.cheapest)}; background:${r.kit.color}`}></span>
            <span class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 size-3 rounded-full border-2 border-ink" style={`left:${pct(r.allIn)}; background:${r.kit.color}`}></span>
            <span
              class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 rounded-full px-2.5 py-1 font-mono text-[0.72rem] font-bold text-ink whitespace-nowrap border-2 border-ink"
              style={`left:${pct(r.picks)}; background:${r.kit.color}`}
            >
              {formatPrice(r.picks)}
            </span>
          </div>
          <p class="sm:col-start-2 font-mono text-[0.72rem] text-paper/50 mt-1 sm:hidden">
            {formatPrice(r.cheapest)} cheapest · {formatPrice(r.allIn)} all in
          </p>
        </li>
      ))}
    </ul>
  </div>
  <figcaption class="mt-12 sm:mt-14 flex flex-wrap gap-x-6 gap-y-2 text-sm text-paper/60">
    <span class="inline-flex items-center gap-2"><span class="size-3 rounded-full bg-paper/60 border-2 border-ink"></span> Cheapest option in every category, then the long term buy in every category</span>
    <span class="inline-flex items-center gap-2"><span class="rounded-full bg-paper/80 text-ink px-2 font-mono text-[0.7rem] font-bold">$</span> Our picks, the whole kit</span>
  </figcaption>
</figure>
