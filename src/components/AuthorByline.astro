---
import type { Author } from '../data/authors';

interface Props {
  author: Author;
  reviewedDate: string;
}

const { author, reviewedDate } = Astro.props;
---

<div class="flex items-center gap-3 py-4 border-t border-b border-gray-100 my-6">
  <a href={`/authors/${author.slug}`} class="flex-shrink-0">
    <div class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center text-sm font-bold text-gray-500">
      {author.name.split(' ').map((n: string) => n[0]).join('')}
    </div>
  </a>
  <div class="min-w-0">
    <p class="text-sm">
      <span class="text-gray-500">By </span>
      <a href={`/authors/${author.slug}`} class="font-semibold text-gray-900 hover:text-blue-600 transition-colors">
        {author.name}
      </a>
      <span class="text-gray-400 mx-1.5">·</span>
      <span class="text-xs text-gray-500">{author.title}</span>
    </p>
    <p class="text-xs text-gray-400 mt-0.5">Last reviewed: {reviewedDate}</p>
  </div>
</div>
