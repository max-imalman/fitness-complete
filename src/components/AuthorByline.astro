---
import type { Author } from '../data/authors';

interface Props {
  author: Author;
  reviewedDate: string;
}

const { author, reviewedDate } = Astro.props;
---

<div class="flex items-center gap-3 py-4 border-t border-b border-gray-100 my-6">
  <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-xs font-bold text-gray-400 flex-shrink-0">
    {author.initials}
  </div>
  <div class="min-w-0">
    <p class="text-sm font-semibold text-gray-700">{author.name}</p>
    <p class="text-xs text-gray-400 mt-0.5">Last reviewed: {reviewedDate}</p>
  </div>
</div>
