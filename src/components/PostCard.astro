---
import type { Post } from '../data/types';
import { getKit } from '../data/kits';

interface Props {
  post: Post;
  index?: number;
}

const { post, index = 0 } = Astro.props;
const kit = getKit(post.kit);
---
<a
  href={`/blog/${post.slug}`}
  class="reveal group flex flex-col rounded-[1.5rem] border-2 border-ink bg-card p-6 transition-[transform,box-shadow,opacity] duration-500 hover:-translate-y-1 hover:shadow-[6px_6px_0_0_var(--c)]"
  style={`--c:${kit.color}; transition-delay:${index * 50}ms`}
>
  <div class="flex items-center justify-between gap-3">
    <span class="tag inline-flex items-center gap-2">
      <span class="size-2.5 rounded-full" style={`background:${kit.color}`}></span>
      {kit.sport}
    </span>
    <span class="tag opacity-50">{post.readMinutes} min read</span>
  </div>
  <h3 class="mt-6 font-display font-bold text-[1.55rem] leading-[1.02] tracking-tight group-hover:underline decoration-[3px] underline-offset-4" style={`text-decoration-color:${kit.color}`}>
    {post.title}
  </h3>
  <p class="mt-3 text-muted text-[0.95rem] leading-snug">{post.description}</p>
  <span class="mt-auto pt-6 font-semibold text-sm inline-flex items-center gap-1.5">
    Read the guide
    <svg viewBox="0 0 24 24" class="size-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  </span>
</a>
