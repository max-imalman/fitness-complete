---
import Layout from '../layouts/Layout.astro';
import { giftAngles, giftIdeas } from '../data/gifts';
import { getKit, kits, kitPath } from '../data/kits';
import { affiliateUrl, formatRange, outboundRel, retailerName } from '../lib/links';
import { organization } from '../lib/seo';
import GearArt from '../components/GearArt.astro';

const budgets = [
  { id: 'under-50', label: 'Under $50', test: (min: number) => min < 50 },
  { id: '50-150', label: '$50 to $150', test: (min: number) => min >= 50 && min < 150 },
  { id: '150-plus', label: '$150 and up', test: (min: number) => min >= 150 },
];
const bucket = (min: number) => budgets.find((b) => b.test(min))!.id;

const ideas = [...giftIdeas]
  .sort((a, b) => a.min - b.min)
  .map((g) => ({ ...g, kitData: getKit(g.kit), budget: bucket(g.min), href: affiliateUrl(g.url), retailer: retailerName(g.url) }));
---

<Layout
  title="Fitness Gift Finder: Gifts for Someone Starting Out"
  description="Gift ideas for someone starting the gym, Pilates, running, a home gym, or pickleball. Filter by sport and budget, from under $50 to serious splurges."
  schema={organization}
  breadcrumbs={[{ name: 'Gift finder', path: '/gifts' }]}
  darkHeader
>
  <section class="bg-ink text-paper grain overflow-hidden">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 pt-10 sm:pt-16 pb-16 sm:pb-24 relative">
      <p class="tag text-paper/50">GIFT 06 · for someone starting out</p>
      <h1 class="mt-6 font-display font-extrabold text-[clamp(3.2rem,10vw,8.5rem)] leading-[0.84] tracking-[-0.055em] max-w-5xl">
        Gifts they will <span class="text-volt">actually</span> use.
      </h1>
      <p class="mt-7 text-lg sm:text-xl text-paper/70 max-w-2xl leading-relaxed">
        A gym membership without the gear is half a gift. Pick the sport, set a budget, and give them the thing beginners always wish they had on day one.
      </p>
      <div class="hidden md:grid absolute right-8 top-12 size-48 lg:size-56 place-items-center rounded-full bg-volt text-ink rotate-12 shadow-[6px_6px_0_0_#f3f0e8]" aria-hidden="true">
        <p class="font-display font-extrabold text-center text-2xl lg:text-3xl leading-[0.9] tracking-tight">Better<br />than a<br />gift card</p>
        <span class="absolute inset-3 rounded-full border-2 border-dashed border-ink/40"></span>
      </div>
    </div>
  </section>

  <!-- Filters -->
  <div class="sticky top-16 z-30 bg-paper/90 backdrop-blur-md border-b border-line">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 py-3 flex flex-col md:flex-row md:items-center gap-3 md:gap-6">
      <div class="flex gap-2 overflow-x-auto [scrollbar-width:none]" role="group" aria-label="Filter by sport">
        <button type="button" class="chip" data-filter="sport" data-value="all" aria-pressed="true">All sports</button>
        {kits.map((k) => (
          <button type="button" class="chip" data-filter="sport" data-value={k.slug} aria-pressed="false" style={`--c:${k.color}`}>
            <span class="size-2.5 rounded-full" style={`background:${k.color}`}></span>{k.sport}
          </button>
        ))}
      </div>
      <div class="flex gap-2 overflow-x-auto [scrollbar-width:none] md:ml-auto" role="group" aria-label="Filter by budget">
        <button type="button" class="chip" data-filter="budget" data-value="all" aria-pressed="true">Any budget</button>
        {budgets.map((b) => (
          <button type="button" class="chip" data-filter="budget" data-value={b.id} aria-pressed="false">{b.label}</button>
        ))}
      </div>
    </div>
  </div>

  <section class="max-w-[1320px] mx-auto px-4 sm:px-6 pt-10">
    <!-- Gift angle for the selected sport -->
    {kits.map((k) => (
      <div data-angle={k.slug} hidden class="mb-8 rounded-[1.5rem] border-2 border-ink p-6 sm:p-8 grid md:grid-cols-[minmax(0,1fr)_auto] gap-5 items-center" style={`background:${k.color}`}>
        <p class="font-display font-bold text-[1.4rem] sm:text-[1.7rem] leading-[1.1] tracking-tight max-w-3xl">{giftAngles[k.slug]}</p>
        <a href={kitPath(k)} class="btn btn-ink">See the full {k.sport.toLowerCase()} kit</a>
      </div>
    ))}

    <p class="tag text-muted mb-5" aria-live="polite"><span data-count>{ideas.length}</span> gift ideas</p>

    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-gifts>
      {ideas.map((g) => (
        <li data-sport={g.kit} data-budget={g.budget} class="gift-card">
          <article class="group relative h-full flex flex-col rounded-[1.5rem] border-2 border-ink bg-card overflow-hidden transition-transform duration-300 hover:-rotate-1 hover:-translate-y-1" style={`--c:${g.kitData.color}`}>
            <div class="relative px-6 pt-6 pb-5 border-b-2 border-dashed border-ink/25" style={`background:${g.kitData.color}`}>
              <span class="absolute left-1/2 -translate-x-1/2 top-3 size-4 rounded-full bg-paper border-2 border-ink" aria-hidden="true"></span>
              <p class="tag">{g.kitData.sport}</p>
              <div class="mt-4 flex items-end justify-between gap-3">
                <p class="font-display font-extrabold text-4xl tracking-tighter tabular-nums">{formatRange(g.min, g.max)}</p>
                <div class="flex -space-x-4 shrink-0">
                  {g.art.map((kind, j) => (
                    <GearArt kind={kind} fill="#fbfaf6" accent={j % 2 ? '#d8ff36' : g.kitData.color} class="size-16 transition-transform duration-500 group-hover:rotate-6" />
                  ))}
                </div>
              </div>
              {g.featured && (
                <span class="absolute right-4 -bottom-4 rotate-6 bg-ink text-volt font-display font-extrabold text-sm px-3 py-1.5 rounded-lg">Top gift</span>
              )}
            </div>
            <div class="flex-1 flex flex-col px-6 pt-6 pb-6">
              <h2 class="font-display font-bold text-[1.4rem] leading-[1.05] tracking-tight">{g.name}</h2>
              {g.note && <p class="mt-3 text-muted text-[0.95rem] leading-snug">{g.note}</p>}
              <div class="mt-auto pt-6 flex items-center justify-between gap-3">
                <a href={kitPath(g.kitData)} class="text-sm font-semibold underline underline-offset-4 decoration-2 hover:decoration-[var(--c)]">Why it works</a>
                <a href={g.href} target="_blank" rel={outboundRel} class="btn btn-ink !py-2.5 !px-4 text-sm">
                  {g.retailer}
                  <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M7 17L17 7M9 7h8v8" /></svg>
                </a>
              </div>
            </div>
          </article>
        </li>
      ))}
    </ul>

    <div data-empty hidden class="rounded-[1.5rem] border-2 border-dashed border-ink/30 p-10 text-center">
      <p class="font-display font-extrabold text-3xl">Nothing in that budget yet.</p>
      <p class="mt-2 text-muted">Try another budget, or build a custom gift from the full kit.</p>
    </div>

    <p class="mt-10 text-sm text-muted max-w-3xl">
      Prices are approximate ranges for US retail and move with sales. Combo gifts add up the items from the matching kit. We earn a commission if you buy through these links, at no extra cost to you.
    </p>
  </section>
</Layout>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex-shrink: 0;
    white-space: nowrap;
    border: 2px solid rgb(13 15 12 / 0.15);
    border-radius: 999px;
    padding: 0.45rem 0.9rem;
    font-size: 0.88rem;
    font-weight: 600;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  .chip:hover { border-color: var(--color-ink); }
  .chip[aria-pressed="true"] { background: var(--color-ink); border-color: var(--color-ink); color: var(--color-paper); }
</style>

<script>
  const state = { sport: 'all', budget: 'all' };
  const params = new URLSearchParams(location.search);
  if (params.get('sport')) state.sport = params.get('sport')!;
  if (params.get('budget')) state.budget = params.get('budget')!;

  const apply = () => {
    let shown = 0;
    document.querySelectorAll<HTMLElement>('.gift-card').forEach((card) => {
      const ok = (state.sport === 'all' || card.dataset.sport === state.sport) && (state.budget === 'all' || card.dataset.budget === state.budget);
      card.hidden = !ok;
      if (ok) shown++;
    });
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => {
      b.setAttribute('aria-pressed', String(state[b.dataset.filter as 'sport' | 'budget'] === b.dataset.value));
    });
    document.querySelectorAll<HTMLElement>('[data-angle]').forEach((el) => (el.hidden = el.dataset.angle !== state.sport));
    document.querySelector('[data-count]')!.textContent = String(shown);
    (document.querySelector('[data-empty]') as HTMLElement).hidden = shown > 0;

    const url = new URL(location.href);
    for (const key of ['sport', 'budget'] as const) {
      if (state[key] === 'all') url.searchParams.delete(key);
      else url.searchParams.set(key, state[key]);
    }
    history.replaceState(null, '', url);
  };

  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) =>
    b.addEventListener('click', () => {
      state[b.dataset.filter as 'sport' | 'budget'] = b.dataset.value!;
      apply();
    }),
  );
  apply();
</script>
