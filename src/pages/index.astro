---
import Layout from '../layouts/Layout.astro';
import Marquee from '../components/Marquee.astro';
import KitTile from '../components/KitTile.astro';
import ScoreCard from '../components/ScoreCard.astro';
import CostChart from '../components/CostChart.astro';
import PostCard from '../components/PostCard.astro';
import { kits, kitPath, pickOf, scoreOf, scoreTotal, siteStats, getKit } from '../data/kits';
import { posts } from '../data/posts';
import { formatPrice } from '../lib/links';
import { organization, SITE_URL } from '../lib/seo';

const stats = siteStats();
const gym = getKit('gym');
const receiptLines = gym.categories.map((c) => ({ category: c.name, ...pickOf(c.options) }));
const receiptTotal = receiptLines.reduce((n, l) => n + l.price, 0);

// Highest scoring product anywhere on the site, used as the live example of the score.
const scored = kits.flatMap((kit) =>
  kit.categories.flatMap((c) =>
    c.options.flatMap((o) => {
      const s = scoreOf(o, c.score);
      return s ? [{ kit, category: c, option: o, score: s }] : [];
    }),
  ),
);
const best = scored.reduce((a, b) => (scoreTotal(b.score) > scoreTotal(a.score) ? b : a));

const featuredPosts = [...posts].sort((a, b) => b.published.localeCompare(a.published)).slice(0, 3);

const schema = [
  organization,
  { '@type': 'WebSite', '@id': `${SITE_URL}/#website`, name: 'fitness-complete', url: SITE_URL, publisher: { '@id': `${SITE_URL}/#organization` } },
];

const rules = [
  { n: '01', title: 'Beginners first', body: 'We read what people starting out say actually helped them, not what experienced athletes upvote.' },
  { n: '02', title: 'Tested, not hyped', body: 'We cross check with hands on tests from sites like Wirecutter and Garage Gym Reviews. When no test exists, the score says so.' },
  { n: '03', title: 'Commission never decides', body: 'It is a tiebreaker at most. When two products tie, the one that pays us less wins.' },
  { n: '04', title: 'Recalls checked', body: 'We check for safety recalls before anything goes on a list, and flag them when they hit something you might own.' },
];
---

<Layout
  title="fitness-complete: Starter Kits for Every Sport"
  description="Beginner starter kits for gym, Pilates, running, home gym, and pickleball. Every product scored out of 100 from real reviews and independent tests. Never ranked by commission."
  schema={schema}
  darkHeader
>
  <!-- Hero -->
  <section class="bg-ink text-paper grain overflow-hidden">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 pt-10 sm:pt-16 pb-20 sm:pb-28 grid lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)] gap-14 lg:gap-12 items-center">
      <div class="min-w-0">
        <p class="tag text-paper/60 flex flex-wrap items-center gap-x-3 gap-y-1">
          <span class="inline-flex items-center gap-2"><span class="size-2 rounded-full bg-volt animate-pulse"></span>Starter kits</span>
          <span>/</span><span>{stats.products} products scored</span>
          <span>/</span><span>0 sponsored picks</span>
        </p>

        <h1 class="mt-7 font-display font-extrabold text-[clamp(3.1rem,8.2vw,7.2rem)] lg:text-[clamp(4rem,6.4vw,6.9rem)] leading-[0.86] tracking-[-0.055em]">
          <span class="block">Start</span>
          <span class="word-cycle !grid text-volt" aria-hidden="true">
            <span>lifting</span>
            <span>Pilates</span>
            <span>running</span>
            <span>at home</span>
            <span>pickleball</span>
          </span>
          <span class="sr-only">lifting, Pilates, running, at home, or pickleball</span>
          <span class="block">
            with the right{' '}
            <span class="relative inline-block">
              gear.
              <span class="hidden sm:block absolute -right-10 -top-8 rotate-[8deg] bg-paper text-ink text-[0.9rem] sm:text-[1.05rem] font-display font-extrabold tracking-tight px-3 py-1.5 rounded-lg shadow-[3px_3px_0_0_var(--color-volt)] whitespace-nowrap">
                nothing extra
              </span>
            </span>
          </span>
        </h1>
        <span class="sm:hidden mt-5 inline-block -rotate-3 bg-paper text-ink font-display font-extrabold tracking-tight px-3 py-1.5 rounded-lg shadow-[3px_3px_0_0_var(--color-volt)]" aria-hidden="true">nothing extra</span>

        <p class="mt-8 text-lg sm:text-xl text-paper/70 max-w-xl leading-relaxed">
          Five sports. Every item a beginner actually needs, in three budgets, scored out of 100 from verified reviews and independent tests. Like advice from the friend who has already made the mistakes.
        </p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#kits" class="btn btn-volt text-base">
            Pick your sport
            <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
          </a>
          <a href="/gifts" class="btn btn-ghost text-paper text-base">Shopping for someone else?</a>
        </div>
      </div>

      <!-- Receipt preview -->
      <div class="relative mx-auto w-full max-w-[22rem] lg:max-w-none">
        <div class="absolute -inset-6 rounded-full blur-3xl opacity-25" style={`background:${gym.color}`} aria-hidden="true"></div>
        <div class="relative rotate-[3deg] hover:rotate-0 transition-transform duration-500 drop-shadow-[0_30px_40px_rgba(0,0,0,0.5)]">
          <div class="receipt-edge"></div>
          <div class="receipt text-ink px-6 pt-4 pb-6 text-[0.8rem]">
            <div class="text-center border-b-2 border-dashed border-ink/25 pb-4">
              <p class="font-display font-extrabold text-2xl tracking-tight">fitness<span class="font-light">complete</span></p>
              <p class="mt-1 opacity-60">{gym.tag} · STARTER KIT · OUR PICKS</p>
            </div>
            <ul class="py-4 space-y-3">
              {receiptLines.map((l) => (
                <li class="flex gap-3 justify-between">
                  <span>
                    <span class="block font-bold uppercase">{l.category}</span>
                    <span class="block opacity-60 leading-tight">{l.name}</span>
                  </span>
                  <span class="font-bold tabular-nums">{formatPrice(l.price)}</span>
                </li>
              ))}
            </ul>
            <div class="border-t-2 border-dashed border-ink/25 pt-3 flex justify-between text-base font-bold">
              <span>TOTAL</span><span class="tabular-nums">{formatPrice(receiptTotal)}</span>
            </div>
            <p class="mt-1 opacity-60">Approx. prices · day one ready</p>
            <a href={kitPath(gym)} class="mt-5 block text-center bg-ink text-paper rounded-full py-2.5 font-bold hover:bg-ink-3 transition-colors">Build your own kit →</a>
            <div class="mt-5 h-10 opacity-80" style="background:repeating-linear-gradient(90deg,#0d0f0c 0 2px,transparent 2px 4px,#0d0f0c 4px 5px,transparent 5px 8px,#0d0f0c 8px 11px,transparent 11px 13px)" aria-hidden="true"></div>
          </div>
          <div class="receipt-edge bottom"></div>
        </div>
      </div>
    </div>
  </section>

  <Marquee items={['Scored out of 100', 'Commission never decides', 'Recall checked', 'Researched from real beginners', 'Three budgets per item', 'No influencer picks']} />

  <!-- Kits -->
  <section id="kits" class="max-w-[1320px] mx-auto px-4 sm:px-6 pt-20 sm:pt-28">
    <div class="flex flex-wrap items-end justify-between gap-6 mb-10">
      <h2 class="reveal font-display font-extrabold text-[clamp(2.6rem,6vw,4.8rem)] leading-[0.88] max-w-3xl">
        What are you <span class="italic font-light">starting?</span>
      </h2>
      <p class="reveal text-muted max-w-sm">
        Pick a sport. Every kit lists only what you need for the first 90 days, and lets you build it at the budget you want.
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {kits.map((kit, i) => <KitTile kit={kit} index={i} />)}

      <a href="/gifts" class="reveal group relative overflow-hidden rounded-[1.75rem] border-2 border-ink bg-volt p-6 sm:p-7 min-h-[23rem] flex flex-col transition-[transform,box-shadow,opacity] duration-500 hover:-translate-y-1 hover:shadow-[8px_8px_0_0_var(--color-ink)]" style="transition-delay:300ms">
        <span class="tag self-start rounded-full border-2 border-current px-2.5 py-1">GIFT 06</span>
        <h3 class="mt-8 font-display font-extrabold text-[3.2rem] sm:text-[3.6rem] leading-[0.85] tracking-tighter">Gift<br />finder</h3>
        <p class="mt-4 max-w-[30ch]">They just got a membership. You want to get them something they will actually use. Filter by sport and budget.</p>
        <div class="mt-auto pt-6 flex flex-wrap gap-2">
          {['Under $50', '$50 to $150', '$150 and up'].map((b) => (
            <span class="rounded-full bg-ink text-volt px-3 py-1.5 text-sm font-bold">{b}</span>
          ))}
        </div>
        <svg viewBox="0 0 120 120" class="absolute -right-6 -bottom-6 size-40 opacity-90 transition-transform duration-700 group-hover:rotate-12 group-hover:scale-110" aria-hidden="true">
          <rect x="18" y="44" width="84" height="64" rx="6" fill="#0d0f0c" />
          <rect x="12" y="30" width="96" height="20" rx="5" fill="#0d0f0c" />
          <rect x="54" y="30" width="12" height="78" fill="#d8ff36" />
          <path d="M60 30c-10-18-30-18-28-6 2 9 18 8 28 6zm0 0c10-18 30-18 28-6-2 9-18 8-28 6z" fill="none" stroke="#0d0f0c" stroke-width="6" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Score -->
  <section class="max-w-[1320px] mx-auto px-4 sm:px-6 pt-24 sm:pt-32">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <div>
        <p class="reveal tag text-muted">The score</p>
        <h2 class="reveal mt-4 font-display font-extrabold text-[clamp(2.6rem,6vw,4.8rem)] leading-[0.88]">
          100 points.<br /><span class="outline-text">Zero</span> for commission.
        </h2>
        <p class="reveal mt-6 text-lg text-muted max-w-xl">
          Every product we list gets scored the same way. Half the points come from long term verified reviews, a third from independent hands on tests, and the rest from one question: does it stop a beginner from making a common mistake? Anything under 45 does not make the cut.
        </p>
        <a href="/how-we-pick" class="reveal mt-8 btn btn-ink">See the full method</a>
      </div>

      <div class="reveal relative rounded-[2rem] border-2 border-ink bg-card p-7 sm:p-10 shadow-[10px_10px_0_0_var(--color-ink)]">
        <p class="tag text-muted">Top scorer on the site right now</p>
        <div class="mt-5 flex items-center gap-5">
          {best.option.img && (
            <span class="size-20 shrink-0 rounded-2xl border-2 border-ink bg-white grid place-items-center overflow-hidden">
              <img src={best.option.img} alt="" class="size-16 object-contain" loading="lazy" />
            </span>
          )}
          <div>
            <p class="font-display font-extrabold text-2xl leading-tight tracking-tight">{best.option.name}</p>
            <a href={`${kitPath(best.kit)}#${best.category.id}`} class="text-sm text-muted hover:underline">{best.kit.sport} kit · {best.category.name}</a>
          </div>
        </div>
        <div class="mt-8">
          <ScoreCard score={best.score} size="lg" color={best.kit.color} />
        </div>
      </div>
    </div>
  </section>

  <!-- Cost chart -->
  <section class="mt-24 sm:mt-32 bg-ink text-paper grain">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 py-20 sm:py-28">
      <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-12 lg:gap-16">
        <div>
          <p class="reveal tag text-paper/50">Real numbers</p>
          <h2 class="reveal mt-4 font-display font-extrabold text-[clamp(2.4rem,5.5vw,4.4rem)] leading-[0.9]">
            What starting <span class="text-volt">actually</span> costs.
          </h2>
          <p class="reveal mt-6 text-paper/65 text-lg max-w-md">
            Every kit item comes in three budgets. Here is the full spread, from the cheapest option in every category to the long term buy in every category, with our picks in the middle.
          </p>
          <p class="reveal mt-4 text-paper/40 text-sm max-w-md">Approximate US prices as of our last review in March 2026.</p>
        </div>
        <CostChart />
      </div>
    </div>
  </section>

  <!-- Rules -->
  <section class="max-w-[1320px] mx-auto px-4 sm:px-6 pt-24 sm:pt-32">
    <h2 class="reveal font-display font-extrabold text-[clamp(2.4rem,5.5vw,4.4rem)] leading-[0.9] max-w-3xl">
      House rules.
    </h2>
    <ol class="mt-12 grid gap-px bg-ink border-2 border-ink rounded-[1.75rem] overflow-hidden sm:grid-cols-2 lg:grid-cols-4">
      {rules.map((r, i) => (
        <li class="reveal bg-card p-7 min-h-[16rem] flex flex-col" style={`transition-delay:${i * 70}ms`}>
          <span class="font-display font-extrabold text-6xl leading-none tracking-tighter outline-text">{r.n}</span>
          <h3 class="mt-auto pt-10 font-display font-bold text-2xl leading-tight">{r.title}</h3>
          <p class="mt-2 text-muted text-[0.95rem] leading-snug">{r.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Guides -->
  <section class="max-w-[1320px] mx-auto px-4 sm:px-6 pt-24 sm:pt-32">
    <div class="flex flex-wrap items-end justify-between gap-6 mb-10">
      <h2 class="reveal font-display font-extrabold text-[clamp(2.4rem,5.5vw,4.4rem)] leading-[0.9]">
        Before your first session.
      </h2>
      <a href="/blog" class="reveal btn btn-ghost">All guides</a>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {featuredPosts.map((post, i) => <PostCard post={post} index={i} />)}
    </div>
  </section>
</Layout>
