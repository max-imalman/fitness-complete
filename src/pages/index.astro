---
import Layout from '../layouts/Layout.astro';
import SchemaOrg from '../components/SchemaOrg.astro';

const siteSchema = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'fitness-complete',
    url: 'https://www.fitness-complete.com',
    logo: 'https://www.fitness-complete.com/favicon.svg',
    contactPoint: { '@type': 'ContactPoint', email: 'hello@fitness-complete.com' },
    sameAs: [],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'fitness-complete',
    url: 'https://www.fitness-complete.com',
  },
]);

const sports = [
  {
    name: 'Gym',
    slug: 'gym-starter-set',
    description: 'Gym bag, water bottle, gloves, and a shaker. The five things every beginner actually needs before their first session.',
    accent: 'text-orange-700',
    bgAccent: 'bg-orange-50',
    borderColor: 'border-t-orange-500',
    icon: '🏋️',
    items: ['Gym bag', 'Water bottle', 'Gloves', 'Shaker bottle', 'Gym towel'],
  },
  {
    name: 'Pilates',
    slug: 'pilates-starter-set',
    description: 'Mat, grip socks, and resistance bands. The essentials for reformer or mat classes, without overbuying.',
    accent: 'text-purple-700',
    bgAccent: 'bg-purple-50',
    borderColor: 'border-t-purple-500',
    icon: '🧘',
    items: ['Pilates mat', 'Grip socks', 'Resistance bands', 'Water bottle', 'Grip gloves'],
  },
  {
    name: 'Running',
    slug: 'running-starter-set',
    description: 'The right shoes are 90% of it. Plus what to wear and carry so your first few miles don\'t suck.',
    accent: 'text-green-700',
    bgAccent: 'bg-green-50',
    borderColor: 'border-t-green-500',
    icon: '👟',
    items: ['Running shoes', 'Running socks', 'Moisture-wicking shirt', 'Hydration belt'],
  },
  {
    name: 'Home Gym',
    slug: 'home-gym-starter-set',
    description: 'Build a functional setup that doesn\'t take over your living room. Prioritized by what you\'ll actually use.',
    accent: 'text-blue-700',
    bgAccent: 'bg-blue-50',
    borderColor: 'border-t-blue-500',
    icon: '🏠',
    items: ['Adjustable dumbbells', 'Resistance bands', 'Pull-up bar', 'Exercise mat', 'Foam roller'],
  },
  {
    name: 'Pickleball',
    slug: 'pickleball-starter-set',
    description: 'Paddle, shoes with lateral support, and the right balls for your surface. Everything a beginner needs before their first game.',
    accent: 'text-teal-700',
    bgAccent: 'bg-teal-50',
    borderColor: 'border-t-teal-500',
    icon: '🏓',
    items: ['Paddle', 'Court shoes', 'Balls', 'Bag', 'Eyewear'],
  },
];
---

<Layout title="Fitness-Complete: Starter Kits for Every Sport" schema={siteSchema}>

  <main>

    <!-- Page subtitle -->
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 pt-5 pb-8">
      <p class="text-sm text-gray-500">Curated starter kits for gym, Pilates, running, home gym, and pickleball. Researched from real beginners.</p>
    </div>

    <!-- Sport category cards -->
    <section id="sports" class="max-w-[1400px] mx-auto px-4 sm:px-6 pb-12">

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {sports.map((sport) => (
          <a
            href={`/${sport.slug}`}
            class={`group block rounded-xl border border-gray-200 hover:border-gray-300 hover:shadow-md transition-all duration-200 border-t-4 ${sport.borderColor} p-6`}
          >
            <div class={`inline-flex items-center justify-center w-11 h-11 rounded-lg ${sport.bgAccent} text-2xl mb-4`}>
              {sport.icon}
            </div>
            <h3 class="font-bold text-gray-900 text-base mb-1 group-hover:text-gray-600 transition-colors">
              {sport.name} Starter Kit
            </h3>
            <p class="text-sm text-gray-500 leading-relaxed mb-4">{sport.description}</p>
            <ul class="space-y-1 mb-4">
              {sport.items.map(item => (
                <li class="text-xs text-gray-400 flex items-center gap-1.5">
                  <span class={`w-1 h-1 rounded-full flex-shrink-0 ${sport.bgAccent.replace('bg-', 'bg-').replace('-50', '-400')}`}></span>
                  {item}
                </li>
              ))}
            </ul>
            <span class={`text-xs font-semibold ${sport.accent}`}>
              See the kit →
            </span>
          </a>
        ))}

        <!-- Gifts card -->
        <a
          href="/gifts"
          class="group block rounded-xl border border-amber-200 hover:border-amber-300 hover:shadow-md transition-all duration-200 border-t-4 border-t-amber-500 p-6"
        >
          <div class="inline-flex items-center justify-center w-11 h-11 rounded-lg bg-amber-50 text-2xl mb-4">
            🎁
          </div>
          <h3 class="font-bold text-gray-900 text-base mb-1 group-hover:text-gray-600 transition-colors">
            Gift Ideas
          </h3>
          <p class="text-sm text-gray-500 leading-relaxed mb-4">Shopping for someone else? Find the right gear by sport and budget — from under $50 to full kit splurges.</p>
          <ul class="space-y-1 mb-4">
            {['Under $50', '$50–150', '$150+', 'All 5 sports covered'].map(item => (
              <li class="text-xs text-gray-400 flex items-center gap-1.5">
                <span class="w-1 h-1 rounded-full bg-amber-400 flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
          <span class="text-xs font-semibold text-amber-700">
            See gift picks →
          </span>
        </a>
      </div>
    </section>

    <!-- From the blog -->
    <section class="max-w-[1400px] mx-auto px-4 sm:px-6 py-10 border-t border-gray-100">
      <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-5">From the blog</p>
      <ul class="space-y-4">
        <li>
          <a href="/blog/what-to-bring-to-the-gym-first-day" class="group flex flex-col sm:flex-row sm:items-baseline sm:gap-4">
            <span class="font-semibold text-gray-900 group-hover:text-blue-600 transition-colors text-sm">What to Bring to the Gym on Your First Day</span>
            <span class="text-sm text-gray-400 mt-0.5 sm:mt-0">A short, honest list. No overcomplicating it.</span>
          </a>
        </li>
        <li>
          <a href="/blog/what-shoes-for-pickleball" class="group flex flex-col sm:flex-row sm:items-baseline sm:gap-4">
            <span class="font-semibold text-gray-900 group-hover:text-blue-600 transition-colors text-sm">What Shoes Should You Wear for Pickleball?</span>
            <span class="text-sm text-gray-400 mt-0.5 sm:mt-0">Not running shoes. Here is what actually matters and why.</span>
          </a>
        </li>
      </ul>
    </section>

    <!-- Methodology note -->
    <section class="bg-gray-50 border-t border-gray-100">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 py-8">
        <p class="text-sm text-gray-600">
          <span class="font-semibold text-gray-900">How we pick:</span> Reddit community consensus, independently tested by Wirecutter and Garage Gym Reviews, Amazon verified purchase patterns. Commission rate plays no role. <a href="/how-we-pick" class="text-blue-600 hover:text-blue-800 underline transition-colors">Full methodology →</a>
        </p>
      </div>
    </section>

  </main>

</Layout>
