---
import Layout from '../../layouts/Layout.astro';
import { getAuthor } from '../../data/authors';

const author = getAuthor('ryan-mitchell')!;

const articles = [
  { title: 'Gym Starter Kit', url: '/gym-starter-set', type: 'Starter Kit' },
  { title: 'Pilates Starter Kit', url: '/pilates-starter-set', type: 'Starter Kit' },
  { title: 'Running Starter Kit', url: '/running-starter-set', type: 'Starter Kit' },
  { title: 'Home Gym Starter Kit', url: '/home-gym-starter-set', type: 'Starter Kit' },
  { title: 'Pickleball Starter Kit', url: '/pickleball-starter-set', type: 'Starter Kit' },
  { title: 'How Many Days a Week Should a Beginner Go to the Gym?', url: '/blog/how-many-days-per-week-gym-beginner', type: 'Article' },
  { title: 'How Long Until You See Results from Pilates?', url: '/blog/how-long-to-see-results-from-pilates', type: 'Article' },
  { title: 'How to Build a Home Gym in an Apartment for Under $500', url: '/blog/home-gym-apartment-under-500', type: 'Article' },
  { title: 'How to Start Playing Pickleball: What Nobody Tells Beginners', url: '/blog/how-to-start-playing-pickleball', type: 'Article' },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: author.name,
  description: author.bio,
  url: 'https://www.fitness-complete.com',
});
---

<Layout
  title="fitness-complete Editorial Team | How We Research"
  description="Every recommendation on fitness-complete is researched from Reddit community consensus, independently tested, and verified against real purchase patterns."
  schema={schema}
>
  <main class="max-w-[760px] mx-auto px-4 sm:px-6 py-12">

    <nav class="text-sm text-gray-400 mb-8">
      <a href="/" class="hover:text-gray-600 transition-colors">Home</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">Editorial Team</span>
    </nav>

    <div class="flex items-start gap-5 mb-8">
      <div class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center text-lg font-bold text-gray-400 flex-shrink-0">
        FC
      </div>
      <div>
        <h1 class="text-2xl font-bold text-gray-900">{author.name}</h1>
        <p class="text-gray-500 mt-1 text-sm">{author.title}</p>
      </div>
    </div>

    <div class="mb-10">
      <p class="text-gray-700 leading-relaxed">{author.bio}</p>

      <div class="mt-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-3">Our research process</p>
        <ul class="space-y-2">
          {author.credentials.map((c: string) => (
            <li class="text-sm text-gray-600 flex items-start gap-2">
              <span class="text-gray-300 mt-1 flex-shrink-0">→</span>
              {c}
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-6">
        <a href="/how-we-pick" class="text-sm text-blue-600 hover:text-blue-800 underline transition-colors">Full methodology →</a>
      </div>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-4">Published on fitness-complete</p>
      <ul class="space-y-3">
        {articles.map((article: { title: string; url: string; type: string }) => (
          <li class="flex items-baseline gap-3">
            <span class="text-xs text-gray-400 w-20 flex-shrink-0">{article.type}</span>
            <a href={article.url} class="text-sm text-gray-700 hover:text-blue-600 transition-colors">{article.title}</a>
          </li>
        ))}
      </ul>
    </div>

  </main>
</Layout>
