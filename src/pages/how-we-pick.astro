---
import Layout from '../layouts/Layout.astro';
import ScoreCard from '../components/ScoreCard.astro';
import { siteStats } from '../data/kits';
import { organization } from '../lib/seo';

const stats = siteStats();

const criteria = [
  {
    points: 50,
    title: 'Verified purchase reviews',
    body: 'We skip the star average and read the patterns. Reviews written six or more months after purchase, the 3 star reviews where honest tradeoffs live, and any recurring durability complaint in the 1 stars.',
    bands: [
      ['40 to 50', 'Strong long term pattern, high volume, no recurring quality complaints'],
      ['25 to 39', 'Decent, but some durability concerns or low volume'],
      ['0 to 24', 'Mixed or poor long term reviews'],
    ],
  },
  {
    points: 35,
    title: 'Independent physical tests',
    body: 'Hands on testing catches what reviews miss. We look for sources that physically test gear: Wirecutter, Garage Gym Reviews, CNN Underscored, OutdoorGearLab, GearJunkie.',
    bands: [
      ['30 to 35', 'Tested and recommended by two or more independent sources'],
      ['15 to 29', 'Recommended by one independent source'],
      ['0 to 14', 'No independent test found, or tested and not recommended'],
    ],
  },
  {
    points: 15,
    title: 'Beginner failure prevention',
    body: 'The question nobody else asks: does the design stop a beginner from making a common mistake, or walk them straight into one?',
    bands: [
      ['12 to 15', 'Design actively prevents common beginner mistakes'],
      ['6 to 11', 'Neutral, neither causes nor prevents mistakes'],
      ['0 to 5', 'Design could lead beginners into common mistakes'],
    ],
  },
];

const sources = [
  {
    title: 'Reddit communities',
    body: 'We read r/fitness, r/beginnerfitness, r/xxfitness and the sport specific subreddits, looking for what beginners say actually helped them. Not what gets upvoted by experienced athletes.',
    why: 'Real people with no financial incentive to recommend anything.',
    limit: 'Posts can be years old, so we always check the product is still sold and has not been replaced by a newer version.',
  },
  {
    title: 'Independent test sites',
    body: 'We cross reference with tested picks from Wirecutter, Garage Gym Reviews, CNN Underscored, and similar sites that physically test products.',
    why: 'Physical testing reveals problems that specs and marketing hide.',
    limit: 'Some of these sites run affiliate links too. We check whether their top pick matches what communities recommend.',
  },
  {
    title: 'Amazon reviews, read properly',
    body: 'Verified purchases only. A product with 2,000 reviews and a 4.2 average tells us more than one with 50 reviews and a 4.9.',
    why: 'Volume of real world feedback on exact products at exact price points.',
    limit: 'Reviews can be gamed. Cross referencing with the other sources filters most of that out.',
  },
  {
    title: 'Mid size YouTube channels',
    body: 'Honest video reviews from channels with 10,000 to 500,000 subscribers that do not disclose a sponsorship for the product they review.',
    why: 'Shows real world use, sizing, and build quality in a way photos cannot.',
    limit: 'Not every channel is transparent. We favor channels that also criticize products in the same category.',
  },
];
---

<Layout
  title="How We Pick and Score Products"
  description="Our full method: every product scored out of 100 from verified reviews, independent tests, and beginner failure prevention. Commission never counts."
  schema={organization}
  breadcrumbs={[{ name: 'How we pick', path: '/how-we-pick' }]}
  darkHeader
>
  <section class="bg-ink text-paper grain overflow-hidden">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 pt-10 sm:pt-16 pb-16 sm:pb-24 grid lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] gap-12 items-end">
      <div>
        <p class="tag text-paper/50">Method · {stats.products} products scored</p>
        <h1 class="mt-6 font-display font-extrabold text-[clamp(3rem,9vw,7.5rem)] leading-[0.85] tracking-[-0.055em]">
          How a product <span class="text-volt">earns</span> its spot.
        </h1>
        <p class="mt-7 text-lg sm:text-xl text-paper/70 max-w-xl">
          Four sources, one score out of 100, and a hard rule: commission is never part of it. Anything under 45 does not make the list.
        </p>
      </div>
      <div class="rounded-[1.75rem] border-2 border-paper/15 p-7 text-paper">
        <p class="tag text-paper/50 mb-5">Example: a perfect score</p>
        <ScoreCard score={{ amazon: 50, tests: 35, beginner: 15 }} size="lg" color="#d8ff36" />
      </div>
    </div>
  </section>

  <!-- Score breakdown -->
  <section class="max-w-[1320px] mx-auto px-4 sm:px-6 pt-20 sm:pt-28">
    <h2 class="reveal font-display font-extrabold text-[clamp(2.4rem,5.5vw,4.4rem)] leading-[0.9] max-w-3xl">The 100 point score.</h2>
    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {criteria.map((c, i) => (
        <article class="reveal rounded-[1.75rem] border-2 border-ink bg-card p-7 flex flex-col" style={`transition-delay:${i * 80}ms`}>
          <p class="font-display font-extrabold text-[5rem] leading-[0.8] tracking-tighter">{c.points}<span class="text-2xl text-muted align-top ml-1">pts</span></p>
          <h3 class="mt-6 font-display font-bold text-2xl leading-tight">{c.title}</h3>
          <p class="mt-3 text-muted leading-relaxed">{c.body}</p>
          <dl class="mt-6 pt-5 border-t-2 border-dashed border-ink/20 space-y-3 text-sm">
            {c.bands.map(([range, meaning]) => (
              <div class="grid grid-cols-[5.5rem_1fr] gap-3">
                <dt class="font-mono font-bold">{range}</dt>
                <dd class="text-muted">{meaning}</dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>

    <div class="reveal mt-5 grid gap-5 md:grid-cols-3">
      <div class="rounded-[1.5rem] bg-volt border-2 border-ink p-6">
        <p class="tag">Tier placement</p>
        <p class="mt-3 font-display font-bold text-xl leading-snug">Three options per item, so you can start cheap, buy what we would buy, or buy once for the long term.</p>
      </div>
      <div class="rounded-[1.5rem] bg-ink text-paper p-6">
        <p class="tag text-volt">Minimum score</p>
        <p class="mt-3 font-display font-bold text-xl leading-snug">45 out of 100. Below that, a product does not appear anywhere on the site.</p>
      </div>
      <div class="rounded-[1.5rem] border-2 border-ink bg-card p-6">
        <p class="tag">The tiebreaker</p>
        <p class="mt-3 font-display font-bold text-xl leading-snug">If two products score the same, the one that pays us less commission wins. That is how we prove independence.</p>
      </div>
    </div>
  </section>

  <!-- Sources -->
  <section class="max-w-[1320px] mx-auto px-4 sm:px-6 pt-24 sm:pt-32">
    <h2 class="reveal font-display font-extrabold text-[clamp(2.4rem,5.5vw,4.4rem)] leading-[0.9] max-w-3xl">Where the evidence comes from.</h2>
    <ol class="mt-10 grid gap-px bg-ink border-2 border-ink rounded-[1.75rem] overflow-hidden md:grid-cols-2">
      {sources.map((s, i) => (
        <li class="reveal bg-card p-7 sm:p-9">
          <p class="font-display font-extrabold text-5xl leading-none outline-text">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="mt-6 font-display font-bold text-2xl">{s.title}</h3>
          <p class="mt-3 text-muted leading-relaxed">{s.body}</p>
          <div class="mt-5 space-y-2 text-sm">
            <p><span class="font-bold">Why it counts:</span> <span class="text-muted">{s.why}</span></p>
            <p><span class="font-bold">Its limit:</span> <span class="text-muted">{s.limit}</span></p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Safety + commission -->
  <section class="max-w-[1320px] mx-auto px-4 sm:px-6 pt-24 sm:pt-32 grid gap-5 lg:grid-cols-2">
    <div class="reveal rounded-[2rem] border-2 border-alert bg-alert/8 p-8 sm:p-10">
      <p class="tag text-alert">Safety</p>
      <h2 class="mt-4 font-display font-extrabold text-4xl leading-[0.95]">We check for recalls first.</h2>
      <p class="mt-4 text-ink-2 leading-relaxed">
        Before any piece of equipment goes on a list, we check for safety recalls. When a recall hits something people commonly own, we say so on the page. Example: the original Bowflex SelectTech 552 and 1090 dumbbells were recalled in June 2025, so our home gym kit recommends the redesigned Results Series 552 instead.
      </p>
    </div>
    <div class="reveal rounded-[2rem] bg-ink text-paper p-8 sm:p-10">
      <p class="tag text-volt">Money</p>
      <h2 class="mt-4 font-display font-extrabold text-4xl leading-[0.95]">On commission and affiliate links.</h2>
      <p class="mt-4 text-paper/75 leading-relaxed">
        This site earns affiliate commissions when you buy through our links. That is how it pays for itself. Commission rate is never why a product appears here. A bad recommendation that earns 5% is a bad trade: you do not come back, and you do not send a friend.
      </p>
    </div>
  </section>
</Layout>
