---
import Layout from '../layouts/Layout.astro';
import { organization } from '../lib/seo';

const sections = [
  {
    title: 'What data we collect',
    body: [
      'fitness-complete.com does not collect personal data from visitors. There are no user accounts, no contact forms, no newsletter signups, and no checkout. We do not store your name, email address, or anything that identifies you.',
      'Our hosting provider, Vercel, keeps standard server logs (including IP addresses and browser user agent strings) as part of running the infrastructure. We do not use these logs for marketing.',
    ],
  },
  {
    title: 'Analytics and cookies',
    body: [
      'We use Vercel Web Analytics to count page views and see which pages are useful. It does not use cookies, does not store personal data, and does not track you across other websites. Visits are counted in aggregate only.',
      'This site sets no cookies of its own. The kit builder remembers the options you picked using your browser\'s local storage, so your choices are still there when you come back. That data stays on your device and is never sent to us. Clearing your browser storage removes it.',
    ],
  },
  {
    title: 'Affiliate links',
    body: [
      'This site participates in affiliate programs, including Amazon Associates US and programs through Impact.com and other affiliate networks. When you click a product link and buy something, we may earn a commission at no additional cost to you.',
      'As an Amazon Associate we earn from qualifying purchases. This site is a participant in the Amazon Services LLC Associates Program, an affiliate advertising program designed to provide a means for sites to earn advertising fees by advertising and linking to Amazon.com.',
      'Affiliate relationships do not influence our recommendations. See how we pick for the full method.',
    ],
  },
  {
    title: 'Third party retailers',
    body: [
      'Retailers we link to (Amazon, REI, YETI, brand stores and others) have their own privacy policies and cookie practices. Once you leave this site, their policies apply.',
    ],
  },
  {
    title: 'Contact',
    body: ['Questions about this policy or anything else on the site: hello@fitness-complete.com.'],
  },
];
---

<Layout
  title="Privacy Policy"
  description="Privacy policy for fitness-complete.com: what data we collect (almost none), how analytics and affiliate links work, and how to contact us."
  schema={organization}
  breadcrumbs={[{ name: 'Privacy policy', path: '/privacy-policy' }]}
>
  <section class="max-w-[1320px] mx-auto px-4 sm:px-6 pt-12 sm:pt-20 grid lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-12">
    <div>
      <p class="tag text-muted">Last updated October 2026</p>
      <h1 class="mt-5 font-display font-extrabold text-[clamp(3rem,8vw,6.5rem)] leading-[0.85] tracking-[-0.055em]">
        Privacy, the short version.
      </h1>
      <p class="mt-6 text-lg text-muted max-w-md">We do not want your data. No accounts, no forms, no tracking cookies, no ad pixels.</p>
    </div>
    <div class="space-y-10">
      {sections.map((s) => (
        <section>
          <h2 class="font-display font-bold text-2xl">{s.title}</h2>
          {s.body.map((p) => <p class="mt-3 text-ink-2 leading-relaxed">{p}</p>)}
        </section>
      ))}
    </div>
  </section>
</Layout>
